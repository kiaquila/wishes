{
  "name": "wishes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "npm run build && node scripts/serve-site.mjs",
    "preview": "node scripts/serve-site.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "test:browser": "node --test tests/carousel.browser.test.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:project": "node scripts/run-project-checks.mjs",
    "check:delivery": "node scripts/check-delivery-speed.mjs",
    "delivery:baseline": "node scripts/check-delivery-speed.mjs --update",
    "test:harness": "node --test tests/harness.test.mjs tests/codex-review-gate.test.mjs",
    "preflight": "npm run check:repository && npm run test:harness && npm run check:project && npm run check:delivery"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
