{
  "schemaVersion": 1,
  "projectSlug": "wishes",
  "phase": "implementation",
  "projectChecks": [
    { "name": "Build wishlist", "command": ["npm", "run", "build"] },
    { "name": "Check browser JavaScript", "command": ["node", "--check", "site/app.js"] },
    { "name": "Test wishlist", "command": ["npm", "run", "test:site"] },
    { "name": "Test production guards", "command": ["npm", "run", "test:production"] },
    { "name": "Check CI deploy script", "command": ["bash", "-n", "production/deploy.sh"] },
    { "name": "Check server deploy script", "command": ["bash", "-n", "production/server-deploy.sh"] },
    { "name": "Check SSH entrypoint", "command": ["bash", "-n", "production/ssh-command.sh"] },
    { "name": "Check access installer", "command": ["bash", "-n", "production/install-access.sh"] },
    { "name": "Check edge installer", "command": ["bash", "-n", "production/install-edge.sh"] },
    { "name": "Check live verification script", "command": ["node", "--check", "scripts/verify-production.mjs"] }
  ],
  "performance": {
    "outputDirectory": "dist",
    "entryPages": ["index.html"],
    "allowedExtensions": [".html", ".css", ".js", ".webp", ".woff2", ".txt"],
    "delivery": {
      "baseline": "docs/delivery-baseline.json",
      "tolerance": 0.05,
      "connection": { "downloadKbps": 1600, "rttMs": 150 },
      "viewport": { "cssWidth": 390, "cssHeight": 844, "dpr": 2 }
    }
  }
}
